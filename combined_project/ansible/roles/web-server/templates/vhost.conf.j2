# {{ item.name }} — managed by Ansible, do not edit by hand
Listen {{ item.port }}

<VirtualHost *:{{ item.port }}>
    ServerName {{ ansible_host | default(inventory_hostname) }}
    DocumentRoot /var/www/{{ item.name }}

    <Directory /var/www/{{ item.name }}>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

{% if item.php | default(false) %}
    # PHP enabled for this site
    DirectoryIndex index.php index.html
    <FilesMatch \.php$>
        SetHandler application/x-httpd-php
    </FilesMatch>
{% else %}
    DirectoryIndex index.html index.htm
{% endif %}

    ErrorLog ${APACHE_LOG_DIR}/{{ item.name }}-error.log
    CustomLog ${APACHE_LOG_DIR}/{{ item.name }}-access.log combined
</VirtualHost>
