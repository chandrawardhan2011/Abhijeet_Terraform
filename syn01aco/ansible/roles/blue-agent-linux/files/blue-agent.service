[Unit]
Description=CyberRange Blue Team Agent (Linux)
Documentation=https://cyberrange.local
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/blue-agent
ExecStart=/usr/bin/python3 /opt/blue-agent/blue_agent_linux.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=blue-agent

# Give network a moment on first start
ExecStartPre=/bin/sleep 5

[Install]
WantedBy=multi-user.target
